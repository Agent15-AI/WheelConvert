    "Results never replace existing files. When a folder can’t be written to, they go to Downloads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ergebnisse ersetzen nie vorhandene Dateien. Ist ein Ordner nicht beschreibbar, landen sie im Ordner „Downloads“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resultados nunca sustituyen archivos existentes. Si no se puede escribir en una carpeta, van a Descargas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les résultats ne remplacent jamais les fichiers existants. Si un dossier n’est pas accessible en écriture, ils vont dans Téléchargements."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果が既存のファイルを置き換えることはありません。フォルダに書き込めない場合は「ダウンロード」に保存されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结果绝不会替换现有文件。无法写入某个文件夹时，结果会存入“下载”。"
          }
        }
      }
    },
