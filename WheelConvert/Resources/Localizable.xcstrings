    "Text you can edit: paragraphs, headings and tables in documents; text boxes over the page artwork in PowerPoint. Scanned pages are read with OCR in documents." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeitbarer Text: Absätze, Überschriften und Tabellen in Dokumenten; Textfelder über der Seitengrafik in PowerPoint. Gescannte Seiten werden in Dokumenten per Texterkennung gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto que puedes editar: párrafos, encabezados y tablas en documentos; cuadros de texto sobre la imagen de la página en PowerPoint. Las páginas escaneadas se leen con OCR en los documentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du texte modifiable : paragraphes, titres et tableaux dans les documents ; zones de texte au-dessus de la page en image dans PowerPoint. Les pages numérisées sont lues par OCR dans les documents."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集できるテキスト: 書類では段落、見出し、表、PowerPoint ではページ画像の上のテキストボックスになります。書類ではスキャンしたページを OCR で読み取ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可编辑的文本：文稿中为段落、标题和表格；PowerPoint 中为页面图像上方的文本框。文稿中的扫描页面会通过 OCR 识别。"
          }
        }
      }
    },
    "Text — click to add a text box" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
