    "Choose a canvas and spacing that leave at least 8 × 8 pixels for each image (maximum canvas: 8192 × 8192)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie Leinwand und Abstand so, dass jedem Bild mindestens 8 × 8 Pixel bleiben (Leinwand höchstens 8192 × 8192)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un lienzo y un espaciado que dejen al menos 8 × 8 píxeles para cada imagen (lienzo máximo: 8192 × 8192)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une toile et un espacement qui laissent au moins 8 × 8 pixels à chaque image (toile maximale : 8192 × 8192)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各画像に8 × 8ピクセル以上が残るキャンバスと間隔を選択してください（キャンバスは最大8192 × 8192）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请选取能为每张图像保留至少 8 × 8 像素的画布和间距（画布最大 8192 × 8192）。"
          }
        }
      }
    },
