    "The encoder could not fit this video within the target. Smallest attempt was %@. Choose a larger size." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Encoder konnte dieses Video nicht auf die Zielgröße bringen. Der kleinste Versuch war %@. Wählen Sie eine größere Zielgröße."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El codificador no ha podido ajustar este vídeo al objetivo. El intento más pequeño fue de %@. Elige un tamaño mayor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’encodeur n’a pas pu faire tenir cette vidéo dans la cible. Le plus petit essai faisait %@. Choisissez une taille plus grande."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンコーダでこのビデオを目標サイズに収められませんでした。最小の結果は %@ でした。より大きいサイズを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编码器无法将此视频压缩到目标大小。最小尝试结果为 %@。请选取更大的大小。"
          }
        }
      }
    },
    "The file couldn’t be read. It may be damaged, password-protected or in an unsupported format." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
