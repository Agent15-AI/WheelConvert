    "Free, offline file conversion for your Mac.\nConversions run locally; nothing is uploaded.\nThird-party licenses are in WheelConvert.app/Contents/Resources/Licenses." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlose Offline-Dateikonvertierung für Ihren Mac.\nKonvertierungen laufen lokal; nichts wird hochgeladen.\nLizenzen von Drittanbietern finden Sie in WheelConvert.app/Contents/Resources/Licenses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversión de archivos gratuita y sin conexión para tu Mac.\nLas conversiones se realizan en local; no se sube nada.\nLas licencias de terceros están en WheelConvert.app/Contents/Resources/Licenses."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversion de fichiers gratuite et hors ligne pour votre Mac.\nLes conversions sont effectuées localement ; rien n’est envoyé en ligne.\nLes licences tierces se trouvent dans WheelConvert.app/Contents/Resources/Licenses."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 用の無料オフラインファイル変換。\n変換はローカルで行われ、何もアップロードされません。\n他社製ライセンスは WheelConvert.app/Contents/Resources/Licenses にあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于 Mac 的免费离线文件转换。\n转换在本地进行，不会上传任何内容。\n第三方许可证位于 WheelConvert.app/Contents/Resources/Licenses。"
          }
        }
      }
    },
    "Free, offline file conversion. Every conversion and tool runs on your Mac; files are never uploaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlose Offline-Dateikonvertierung. Jede Konvertierung und jedes Werkzeug läuft auf Ihrem Mac; Dateien werden nie hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversión de archivos gratuita y sin conexión. Cada conversión y herramienta se ejecuta en tu Mac; los archivos nunca se suben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversion de fichiers gratuite et hors ligne. Chaque conversion et chaque outil s’exécutent sur votre Mac ; les fichiers ne sont jamais envoyés en ligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
