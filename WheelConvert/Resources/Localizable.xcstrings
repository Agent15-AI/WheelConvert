    "Blur softens details. Use Solid for sensitive information." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weichzeichnen verwischt Details. Verwenden Sie für vertrauliche Informationen „Deckend“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desenfoque suaviza los detalles. Usa Sólido para la información confidencial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le flou adoucit les détails. Utilisez Opaque pour les informations sensibles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぼかしは細部を和らげるだけです。機密情報には「不透明」を使用してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
