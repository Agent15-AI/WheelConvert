    "Compress works with images, videos, audio and PDFs of one kind at a time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komprimieren funktioniert mit Bildern, Videos, Audio und PDFs – jeweils einer Art auf einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprimir funciona con imágenes, vídeos, audio y PDF, de un solo tipo a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compression fonctionne avec des images, vidéos, fichiers audio et PDF, d’un seul type à la fois."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圧縮は画像、ビデオ、オーディオ、PDF に対応しています。一度に1種類ずつ選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "压缩适用于图像、视频、音频和 PDF，每次只能选择同一种类。"
          }
        }
      }
    },
    "Compress, crop, trim, redact, merge and more. Press the tools key while dragging to see the tools for that kind of file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komprimieren, zuschneiden, kürzen, schwärzen, zusammenfügen und mehr. Drücken Sie beim Ziehen die Werkzeugtaste, um die Werkzeuge für diese Dateiart zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprime, recorta, acorta, oculta, combina y mucho más. Pulsa la tecla de herramientas mientras arrastras para ver las herramientas de ese tipo de archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compresser, recadrer, raccourcir, masquer, fusionner et plus encore. Appuyez sur la touche des outils pendant le glissement pour voir les outils adaptés à ce type de fichier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圧縮、クロップ、トリム、墨消し、結合など。ドラッグ中にツールのキーを押すと、その種類のファイル用のツールが表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "压缩、裁剪、修剪、遮盖、合并等。拖移时按下工具键，即可查看适用于该类文件的工具。"
          }
        }
      }
    },
