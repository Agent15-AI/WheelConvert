<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- JavaScriptCore runs the Pages reader/writer; JIT keeps large documents fast. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- The app is ad-hoc signed, so it has no Team ID, and library validation would refuse to load the
	     embedded Sparkle.framework (Debug builds only load it because they're debuggable). -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
