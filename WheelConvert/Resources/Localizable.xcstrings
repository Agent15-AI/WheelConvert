    "Every clip is saved in one folder. Remove clips to join the rest instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Clips werden in einem Ordner gesichert. Entfernen Sie Clips, um stattdessen die übrigen zusammenzufügen."
          }
        },
