    "Clears camera, location, author and software details. Orientation and color profile are kept so photos look the same." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt Kamera-, Orts-, Autor- und Softwareangaben. Ausrichtung und Farbprofil bleiben erhalten, damit Fotos gleich aussehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra los datos de cámara, ubicación, autor y software. La orientación y el perfil de color se conservan para que las fotos se vean igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface les informations d’appareil, de lieu, d’auteur et de logiciel. L’orientation et le profil colorimétrique sont conservés pour que les photos restent identiques."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラ、位置情報、作成者、ソフトウェアの情報を消去します。写真の見た目が変わらないよう、向きとカラープロファイルは残します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除相机、位置、作者和软件信息。保留方向和颜色描述文件，使照片外观不变。"
          }
        }
      }
    },
