        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegen Sie die Abspielposition zum Wort und klicken Sie dann auf „Piepton an Abspielposition hinzufügen“. Ziehen Sie die Kanten des ausgewählten Bereichs, um ihn anzupassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve el cabezal hasta la palabra y haz clic en Añadir pitido en el cabezal. Arrastra los bordes del intervalo seleccionado para ajustarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez la tête de lecture sur le mot, puis cliquez sur Ajouter un bip à la tête de lecture. Faites glisser les bords de la plage sélectionnée pour l’ajuster."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生ヘッドを単語の位置に移動し、「再生ヘッドにピー音を追加」をクリックします。選択した範囲の端をドラッグして調整します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将播放头移到该词处，然后点按“在播放头处添加哔声”。拖移所选范围的边缘以进行调整。"
          }
        }
      }
    },
    "Move to Trash" : {
