    "Blends the reduced PNG colors so skies and gradients don’t show bands. Files may be a little larger." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mischt die reduzierten PNG-Farben, damit Himmel und Verläufe keine Streifen zeigen. Dateien können etwas größer werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezcla los colores reducidos del PNG para que cielos y degradados no muestren bandas. Los archivos pueden ser algo más grandes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mélange les couleurs PNG réduites pour éviter les bandes dans les ciels et les dégradés. Les fichiers peuvent être un peu plus gros."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "減色した PNG の色を混ぜ合わせ、空やグラデーションに縞が出ないようにします。ファイルが少し大きくなる場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "混合缩减后的 PNG 颜色，使天空和渐变不出现色带。文件可能会稍大。"
          }
        }
      }
    },
