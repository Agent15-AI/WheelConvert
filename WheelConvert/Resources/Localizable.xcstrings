    },
    "−16 LUFS is a balanced default for spoken audio and music. The true peak limit helps prevent clipping after encoding." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "−16 LUFS ist ein ausgewogener Standardwert für Sprache und Musik. Die True-Peak-Grenze hilft, Übersteuerung nach dem Kodieren zu vermeiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "−16 LUFS es un valor predeterminado equilibrado para voz y música. El límite de pico real ayuda a evitar la saturación tras la codificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "−16 LUFS est une valeur par défaut équilibrée pour la voix et la musique. La limite de crête réelle aide à éviter l’écrêtage après l’encodage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "−16 LUFS は音声と音楽のどちらにも適したデフォルト値です。トゥルーピークの上限により、エンコード後のクリッピングを防ぎます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
