    "Start dragging a file in Finder, then press the key. Drop it on a format — the converted copy appears right next to the original." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie eine Datei im Finder und drücken Sie dann die Taste. Legen Sie sie auf einem Format ab – die konvertierte Kopie erscheint direkt neben dem Original."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza a arrastrar un archivo en Finder y pulsa la tecla. Suéltalo sobre un formato: la copia convertida aparece junto al original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez à faire glisser un fichier dans le Finder, puis appuyez sur la touche. Déposez-le sur un format — la copie convertie apparaît juste à côté de l’original."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder でファイルをドラッグし始めてからキーを押します。フォーマットの上にドロップすると、変換したコピーがオリジナルのすぐ横に作成されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在访达中开始拖移文件，然后按下按键。将其放到某个格式上，转换后的副本会出现在原件旁边。"
          }
        }
      }
    },
    "Start dragging a file, then press the keys. The wheel stays open until you drop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginnen Sie, eine Datei zu ziehen, und drücken Sie dann die Tasten. Das Rad bleibt geöffnet, bis Sie loslassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza a arrastrar un archivo y pulsa las teclas. La rueda sigue abierta hasta que lo sueltas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez à faire glisser un fichier, puis appuyez sur les touches. La roue reste ouverte jusqu’à ce que vous déposiez le fichier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルをドラッグし始めてからキーを押します。ドロップするまでホイールは開いたままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始拖移文件，然后按下按键。轮盘会一直打开，直到你松开。"
          }
        }
      }
    },
