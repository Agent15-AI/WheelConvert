    "Pages are scaled proportionally to match the narrowest page; their heights may still differ." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Seiten werden proportional an die schmalste Seite angepasst; ihre Höhen können weiterhin abweichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas se escalan proporcionalmente a la más estrecha; sus alturas pueden seguir siendo distintas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages sont mises à l’échelle proportionnellement à la plus étroite ; leurs hauteurs peuvent encore différer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページは最も狭いページに合わせて比率を保ったまま拡大縮小されます。高さは異なる場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "页面会按比例缩放以匹配最窄的页面；高度仍可能不同。"
          }
        }
      }
    },
